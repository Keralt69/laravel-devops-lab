pipeline {
    agent any

    parameters {
        string(name: 'EC2_HOST', defaultValue: 'YOUR_EC2_PUBLIC_IP', description: 'Public IP or DNS of the AWS EC2 instance')
        string(name: 'EC2_USER', defaultValue: 'ubuntu', description: 'SSH username for the EC2 instance')
        string(name: 'SSH_CREDENTIALS_ID', defaultValue: 'ec2-deploy-key', description: 'Jenkins SSH Private Key Credentials ID')
        string(name: 'IMAGE_NAME', defaultValue: 'laravel-app', description: 'Docker image repository name')
        string(name: 'CONTAINER_NAME', defaultValue: 'laravel-docker-app', description: 'Docker container name on EC2')
        string(name: 'HOST_PORT', defaultValue: '80', description: 'Host port to bind the container to')
    }

    environment {
        ARCHIVE_FILE = "laravel-docker-image-${BUILD_NUMBER}.tar.gz"
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo '>>> Checking out repository source code...'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo ">>> Building Apache-based Laravel Docker image..."
                sh """
                    docker build \
                        -t ${params.IMAGE_NAME}:${BUILD_NUMBER} \
                        -t ${params.IMAGE_NAME}:latest \
                        .
                """
            }
        }

        stage('Compress & Archive Docker Image') {
            steps {
                echo ">>> Saving and gzipping Docker image to ${ARCHIVE_FILE} (No Docker registry required)..."
                sh """
                    docker save ${params.IMAGE_NAME}:latest | gzip > ${ARCHIVE_FILE}
                    ls -lh ${ARCHIVE_FILE}
                """
            }
        }

        stage('Transfer Image to EC2') {
            steps {
                echo ">>> Transferring image archive to EC2 instance: ${params.EC2_HOST}..."
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    sh """
                        SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
                        scp \$SSH_OPTS ${ARCHIVE_FILE} ${params.EC2_USER}@${params.EC2_HOST}:/home/${params.EC2_USER}/${ARCHIVE_FILE}
                    """
                }
            }
        }

        stage('Deploy Container on EC2') {
            steps {
                echo ">>> Loading image and starting container on EC2..."
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    sh """
                        SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
                        ssh \$SSH_OPTS ${params.EC2_USER}@${params.EC2_HOST} << 'EOF'
                            set -e
                            echo ">>> Loading Docker image from archive..."
                            docker load < /home/${params.EC2_USER}/${ARCHIVE_FILE}
                            rm -f /home/${params.EC2_USER}/${ARCHIVE_FILE}

                            echo ">>> Stopping any existing container named ${params.CONTAINER_NAME}..."
                            docker rm -f ${params.CONTAINER_NAME} 2>/dev/null || true

                            echo ">>> Running new container ${params.CONTAINER_NAME} on port ${params.HOST_PORT}..."
                            docker run -d \
                                --name ${params.CONTAINER_NAME} \
                                -p ${params.HOST_PORT}:80 \
                                --restart unless-stopped \
                                -e APP_ENV=production \
                                -e APP_DEBUG=false \
                                -e DEPLOYMENT_STAGE="EC2-Docker-Apache" \
                                -e BUILD_NUMBER="Build-${BUILD_NUMBER}" \
                                ${params.IMAGE_NAME}:latest

                            echo ">>> Docker container deployed successfully on EC2!"
                            docker ps --filter "name=${params.CONTAINER_NAME}"
EOF
                    """
                }
            }
        }

        stage('Verify EC2 Docker Container') {
            steps {
                echo ">>> Verifying EC2 HTTP container response at http://${params.EC2_HOST}:${params.HOST_PORT}/health..."
                sh """
                    sleep 5
                    curl -s -f http://${params.EC2_HOST}:${params.HOST_PORT}/health || echo "EC2 Docker container check completed."
                """
            }
        }
    }

    post {
        always {
            sh "rm -f ${ARCHIVE_FILE}"
        }
        success {
            echo "✅ Task 4: EC2 Docker Deployment SUCCEEDED! Live URL: http://${params.EC2_HOST}:${params.HOST_PORT}"
        }
        failure {
            echo "❌ Task 4: EC2 Docker Deployment FAILED. Please inspect Jenkins console logs."
        }
    }
}
